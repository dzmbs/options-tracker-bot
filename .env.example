# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Underlyings to stream across all 5 venues (Deribit, OKX, Binance, Bybit, Derive).
# Each venue only streams what it actually lists — unsupported symbols are silently skipped.
# Core (all venues):        BTC, ETH, SOL
# Extended (2-4 venues):   XRP, BNB, DOGE, AVAX, ADA, LTC
# Alt/niche (Bybit/OKX):   TRX, HYPE, SUI, TON, ENA, AAVE
UNDERLYINGS=BTC,ETH,SOL,XRP,BNB,DOGE,AVAX,ADA,LTC,TRX,HYPE,SUI,TON,ENA,AAVE

# SQLite path for alert subscriptions (default: data/bot.db)
# DB_PATH=data/bot.db

# Route REST through a proxy when venue APIs geo-block your region (optional).
# WebSocket connections are direct; only REST seed calls go through the proxy.
# HTTPS_PROXY=http://user:pass@host:port

# OKX REST domain. US/AU users (app.okx.com) must use us.okx.com for private endpoints.
# Public block-trade polling works on www.okx.com from any region.
# OKX_REST_BASE_URL=https://www.okx.com

# LOG_LEVEL=debug


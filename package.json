{
  "name": "options-flow-bot",
  "version": "0.0.1",
  "private": true,
  "description": "Telegram bot for crypto options market and flow alerts",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "bot": "tsx src/index.ts",
    "firehose": "tsx src/firehose.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "grammy": "^1.43.0",
    "pino": "10.3.1",
    "undici": "^8.3.0",
    "ws": "8.19.0",
    "zod": "4.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/node": "22.19.15",
    "@types/ws": "8.18.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.8"
  }
}
